# x-search Configuration

# --- Grok（主力搜索）---
# Grok API 端点（官方 api.x.ai/v1，或你的中转地址）
GROK_API_URL=https://api.x.ai/v1
# Grok API Key
GROK_API_KEY=your_grok_key_here
# Grok 模型名
GROK_MODEL=grok-4.20-fast

# --- Tavily（兜底搜索）---
# Tavily API 端点
TAVILY_API_URL=https://api.tavily.com
# Tavily API Key
TAVILY_API_KEY=your_tavily_key_here

# --- Context7（按需库文档，可选）---
# Context7 API Key（可选。有 key 可享受更高频率限制）
# 去 https://context7.com/dashboard 创建
CONTEXT7_API_KEY=
# Context7 API 端点
CONTEXT7_API_URL=https://context7.com/api/v2
